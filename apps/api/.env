# SAARTHI API — local dev environment.
# Postgres for persistent, cross-device storage. Local default points at a local
# Postgres; in production set DATABASE_URL to your managed Postgres (Neon/Supabase/
# Render) connection string, e.g. postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saarthi?schema=public"
PORT=4000
# Dev-only JWT secret. In a real deployment this comes from Vault/KMS (Part G).
JWT_SECRET="praja-setu-pilot-dev-secret-change-me"
JWT_EXPIRES_IN="12h"
# Comma-separated allowed CORS origins for the web app.
WEB_ORIGIN="http://localhost:3000"
# Pilot toggle: expose mock OTP codes in API responses so the demo works without a real SMS gateway.
EXPOSE_MOCK_OTP=true
# Sarvam AI (https://dashboard.sarvam.ai) — real multilingual speech-to-text:
# the SPOKEN language is detected from the audio itself and the transcript comes
# back in the native script. Without a key the app falls back to on-device
# browser recognition. Put the REAL key in .env.local (gitignored), never here.
# SARVAM_API_KEY=sk_...
