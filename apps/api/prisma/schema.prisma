// SAARTHI — data model (Blueprint Part E.1)
// Runs on PostgreSQL so data is PERSISTENT and shared across devices and redeploys
// (any managed Postgres: Neon, Supabase, Render Postgres). Enums are modelled as
// String (validated in code via src/common/constants.ts) and list/JSON fields are
// stored as JSON-encoded String for portability; pgvector/jsonb is the scale path.

generator client {
  provider      = "prisma-client-js"
  // Pin the Linux engine target explicitly so generated client + runtime agree on
  // the engine filename in the container (Debian/Ubuntu, OpenSSL 3.x).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Citizen / Petitioner ────────────────────────────────────────────────────
model Citizen {
  id                String   @id @default(cuid())
  aadhaarToken      String?  @unique // vault reference only — NEVER the raw Aadhaar number
  name              String
  coName            String?  // C/o name (father/husband) — per the PGRS form
  dob               String?  // date of birth (YYYY-MM-DD)
  gender            String?  // MALE | FEMALE | OTHER
  mobile            String
  address           String?
  houseNo           String?
  habitation        String?
  village           String?
  mandal            String?
  district          String?
  secretariatCode   String?
  applicantType     String   @default("INDIVIDUAL") // INDIVIDUAL | COMMUNITY
  languagePref      String   @default("te")
  vulnerabilityFlags String  @default("[]") // JSON array, e.g. ["ELDERLY","DISABILITY"]
  createdAt         DateTime @default(now())

  grievances Grievance[]
  consents   ConsentRecord[]
}

// ── Department / Subject taxonomy ───────────────────────────────────────────
model Department {
  id        String   @id
  nameEn    String
  nameTe    String
  parent    String?
  helpline  String?  // public phone number citizens can call for this department
  slaMatrix String   @default("{}") // JSON: { "<level>": hours }

  subjects   Subject[]
  officers   Officer[]
  grievances Grievance[]
}

model Subject {
  id           String   @id
  deptId       String
  parentId     String?  // null = subject, set = sub-subject
  nameEn       String
  nameTe       String
  defaultSlaHrs Int     @default(168)
  categoryHint String   @default("NON_FINANCE") // FINANCE | NON_FINANCE
  keywords     String   @default("[]") // JSON array — drives the pilot keyword classifier

  department Department @relation(fields: [deptId], references: [id])
  parent     Subject?   @relation("SubjectChildren", fields: [parentId], references: [id])
  children   Subject[]  @relation("SubjectChildren")

  @@index([deptId])
}

// ── Officer / Desk ──────────────────────────────────────────────────────────
model Officer {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  name         String
  role         String  // DA | OFFICER | SUPERVISOR | COLLECTOR | AUDITOR (capability)
  designation  String? // government title shown in UI (Tahsildar, RDO, Collector…)
  deptId       String?
  level        Int     @default(1) // L1..L4 competence for escalation
  jurisdiction String  @default("{}") // JSON: { mandal, secretariatCodes[] }
  iamSubject   String? // mock Keycloak/OIDC subject id
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  department  Department?  @relation(fields: [deptId], references: [id])
  assignments Assignment[]
  workLogs    WorkLog[]
}

// ── Grievance (core) ────────────────────────────────────────────────────────
model Grievance {
  id                  String   @id @default(cuid())
  ysr                 String   @unique // public YSR-style tracking code
  petitionerId        String
  channel             String   // SACHIVALAYAM_ASSISTED | CITIZEN_APP | WEB | IVR | WHATSAPP | SMS | CALL_1902
  language            String   @default("te")

  deptId              String?
  subjectId           String?
  subSubjectId        String?
  category            String   @default("NON_FINANCE") // FINANCE | NON_FINANCE

  description         String
  descriptionEn       String?
  voiceInputRef       String?

  // ── Saarthi 2.0 language intelligence (auto-detected, never citizen-picked) ─
  detectedLang        String?  // ISO 639 of the citizen's speech/text (auto)
  langConfidence      Float?
  codeSwitched        Boolean  @default(false)

  // ── Saarthi 2.0 LLM extraction contract (§7.1) ──
  issue               String?  // one-line issue statement
  issueCategory       String?  // e.g. streetlight_outage
  summaryEn           String?
  summaryTe           String?
  severity            String?  // LOW | MEDIUM | HIGH | CRITICAL (rubric §7.3)
  urgency             String?  // LOW | MEDIUM | HIGH | IMMEDIATE
  safetyFlag          Boolean  @default(false)
  sentiment           String?
  entities            String   @default("{}") // JSON extracted entities
  interDepts          String   @default("[]") // JSON [{deptId,name,why}] — X-Road share suggestions

  aiSuggestedDeptId   String?
  aiSuggestedSubjectId String?
  aiConfidence        Float?
  routedBy            String?  // AI (auto ≥95% gate) | HUMAN (verification desk)

  priorityScore       Float    @default(0)
  distressFlag        Boolean  @default(false)
  emergency           Boolean  @default(false)

  // Live location captured at submit (with citizen consent) — sent to the officer.
  geoLat              Float?
  geoLng              Float?
  geoAccuracy         Float?   // metres
  geoCapturedAt       DateTime?

  // Duplicate-merge (§9): crowd volume IS severity evidence.
  reportCount         Int      @default(1)
  // Location of the grievance (may differ from the petitioner's address — per the form)
  district            String?
  mandal              String?
  village             String?
  secretariatCode     String?
  applicantType       String   @default("INDIVIDUAL") // INDIVIDUAL | COMMUNITY

  status              String   @default("DRAFT")
  currentAssigneeId   String?
  currentLevel        Int      @default(1)

  slaDueAt            DateTime?
  slaBreachPredicted  Boolean  @default(false)
  isDuplicateOf       String?

  createdAt           DateTime @default(now())
  registeredAt        DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?

  petitioner  Citizen      @relation(fields: [petitionerId], references: [id])
  department  Department?  @relation(fields: [deptId], references: [id])
  assignments Assignment[]
  workLogs    WorkLog[]
  attachments Attachment[]
  escalations Escalation[]
  reopens     Reopen[]
  feedback    Feedback[]
  auditEvents AuditEvent[]

  @@index([status])
  @@index([deptId])
  @@index([mandal])
  @@index([currentAssigneeId])
}

model Assignment {
  id          String   @id @default(cuid())
  grievanceId String
  assigneeId  String
  level       Int
  assignedBy  String   // SYSTEM | <officerId>
  reason      String   // explainable routing
  assignedAt  DateTime @default(now())
  acceptedAt  DateTime?

  grievance Grievance @relation(fields: [grievanceId], references: [id])
  assignee  Officer   @relation(fields: [assigneeId], references: [id])

  @@index([grievanceId])
}

model WorkLog {
  id          String   @id @default(cuid())
  grievanceId String
  actorId     String?
  actorRole   String
  actionType  String   // ENQUIRY | ACTION_TAKEN | NOTE | HOLD | RESUME | XROAD_LOOKUP
  noteTe      String?
  noteEn      String?
  aiDrafted   Boolean  @default(false)
  evidenceIds String   @default("[]")
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id])
  actor     Officer?  @relation(fields: [actorId], references: [id])

  @@index([grievanceId])
}

model Attachment {
  id            String   @id @default(cuid())
  grievanceId   String
  type          String   @default("DOCUMENT") // DOCUMENT | VOICE | REOPEN_VOICE
  filename      String?
  mime          String?
  sizeBytes     Int?
  durationSec   Int?     // audio evidence length (voice complaints / reopen reasons)
  originalSizeBytes Int?
  dataBase64    String?  // pilot store (no MinIO) — base64 of the file bytes
  compressed    Boolean  @default(false)
  objectStoreKey String?
  ocrText       String?
  uploadedBy    String?  // CITIZEN | DA | <officerId>
  hash          String?
  createdAt     DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id])

  @@index([grievanceId])
}

model Escalation {
  id          String   @id @default(cuid())
  grievanceId String
  level       Int
  dueAt       DateTime?
  breachedAt  DateTime?
  escalatedTo String?
  trigger     String   // SLA_BREACH | SLA_PREDICTED | REOPEN | EMERGENCY | MANUAL
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id])

  @@index([grievanceId])
}

model Reopen {
  id             String   @id @default(cuid())
  grievanceId    String
  reasonTe       String?
  reasonEn       String?
  reopenedAt     DateTime @default(now())
  escalatedLevel Int

  // ── Quick desk review (Saarthi 2.0) — a reopen request is reviewed by a ──
  // higher officer BEFORE the case reopens. The citizen must state a reason
  // (typed or voice); the voice file travels with the case in its original
  // language, and AI explains the likely reason + citizen background.
  channel        String   @default("TEXT") // TEXT | VOICE
  reasonLang     String?  // detected language of the reason
  reasonAudioId  String?  // Attachment id of the voice reason (original audio)
  aiReview       String?  // JSON — AI quick-desk-review analysis for the officer
  reviewStatus   String   @default("APPLIED") // PENDING | REOPEN_APPROVED | CLOSURE_UPHELD | APPLIED (legacy direct reopen)
  reviewerId     String?  // officer assigned to the desk review
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?

  grievance Grievance @relation(fields: [grievanceId], references: [id])

  @@index([grievanceId])
}

// ── Human verification queue — the 95% confidence gate (Saarthi 2.0 §8) ─────
// When the AI classifier is below the gate (or the two stages disagree), a
// District Grievance Officer confirms the department. The decision feeds the
// active-learning loop (TrainingEvent).
model VerificationTask {
  id           String    @id @default(cuid())
  grievanceId  String    @unique
  suggestions  String    @default("[]") // JSON — AI top-3 [{deptId,name,probability}]
  llmHint      String?   // Stage-A (LLM) department hint
  rationale    String?   // extraction summary shown to the officer
  status       String    @default("PENDING") // PENDING | DECIDED
  assignedTo   String?
  decidedDept  String?
  decidedById  String?
  decidedAt    DateTime?
  slaDeadline  DateTime  // officer must act within 4 working hours
  createdAt    DateTime  @default(now())

  @@index([status])
}

// ── Active-learning loop (Saarthi 2.0 §8.4) — every human correction becomes ─
// a labelled training example for the next classifier fine-tune.
model TrainingEvent {
  id           String   @id @default(cuid())
  grievanceId  String
  aiPrediction String?
  aiConfidence Float?
  humanLabel   String
  source       String   // VERIFY | UNMERGE | REASSIGN | DESK_REVIEW
  createdAt    DateTime @default(now())

  @@index([grievanceId])
}

model Feedback {
  id          String   @id @default(cuid())
  grievanceId String
  rating      Int
  comment     String?
  qaAuditedBy String?
  channel     String?
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id])

  @@index([grievanceId])
}

// ── Consent (powers the assisted path + X-Road cross-dept lookups) ──────────
model ConsentRecord {
  id          String   @id @default(cuid())
  petitionerId String
  purpose     String
  scope       String   @default("[]") // JSON array of dept ids allowed for data pulls
  grantedBy   String   // SELF | DA
  daId        String?
  grantedAt   DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  petitioner Citizen @relation(fields: [petitionerId], references: [id])

  @@index([petitionerId])
}

// ── Ledger / blockchain notary (hash-chained AuditEvent — Part D.2 / G.4) ───
model AuditEvent {
  id          String   @id @default(cuid())
  seq         Int      @unique // chain position (assigned sequentially in LedgerService)
  grievanceId String?
  eventType   String
  actorRole   String
  payload     String   // canonical JSON of the event (off-chain record content)
  payloadHash String   // SHA-256 of canonical payload
  prevHash    String   // hash of previous block — forms the tamper-evident chain
  blockHash   String   @unique // SHA-256(seq + prevHash + payloadHash + ts)
  ledgerTxId  String   @unique // notary transaction id (fabric://… style)
  ts          DateTime @default(now())

  grievance Grievance? @relation(fields: [grievanceId], references: [id])

  @@index([grievanceId])
}

// ── Mock UIDAI OTP (citizen login / eKYC) ───────────────────────────────────
model Otp {
  id        String   @id @default(cuid())
  mobile    String
  code      String
  purpose   String   @default("LOGIN")
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([mobile])
}

// ── X-Road exchange log (signed/logged cross-department lookups — Part D.1) ──
model DataExchangeLog {
  id            String   @id @default(cuid())
  grievanceId   String?
  consentId     String?
  fromMember    String
  toMember      String
  service       String
  requestHash   String
  responseHash  String
  signature     String
  requestedBy   String
  purpose       String
  createdAt     DateTime @default(now())

  @@index([grievanceId])
}

// ── Notifications (mock SMS/email — replaces real gateway in pilot) ─────────
model NotificationLog {
  id          String   @id @default(cuid())
  grievanceId String?
  channel     String   // SMS | EMAIL | IVR
  to          String
  template    String
  body        String
  createdAt   DateTime @default(now())

  @@index([grievanceId])
}
